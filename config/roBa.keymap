#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <2>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

&mkp_input_listener { input-processors = <&zip_temp_layer 2 250>; };

/ {
    combos {
        compatible = "zmk,combos";

        language {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <37 41>;
        };

        click {
            bindings = <&mkp LCLK>;
            key-positions = <38 18>;
        };

        click_r {
            bindings = <&mkp RCLK>;
            key-positions = <38 20>;
        };

        r_click {
            bindings = <&mkp LCLK>;
            key-positions = <18 41>;
        };

        r_click_r {
            bindings = <&mkp RCLK>;
            key-positions = <41 20>;
        };
    };

    behaviors {
        encoder_msc_up_down: encoder_msc_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        st: scroll_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "Scroll / Tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-while-undecided;
        };

        semi: semi {
            compatible = "zmk,behavior-mod-morph";
            label = "SEMI";
            bindings = <&kp SEMI>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        mac_setup: osx_setup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &tog 0>;
            label = "OSX_SETUP";
        };

        win_setup: win_setup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &tog 1>;
            label = "WIN_SETUP";
        };

        syayou: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &tog 6>;
            label = "NEW_MACRO";
        };

        ipad: ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &tog 0>;
            label = "IPAD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_mac {
            bindings = <
&kp Q           &kp W         &kp E             &kp R                    &kp T                                      &kp Y        &kp U  &st 5 I    &kp O    &kp P
&mt LCTRL A     &kp S         &kp D             &kp F                    &kp G        &mkp MCLK      &kp SEMICOLON  &kp H        &kp J  &kp K      &kp L    &kp MINUS
&kp Z           &kp X         &kp C             &kp V                    &lt 4 B      &mo 8          &kp SLASH      &kp N        &kp M  &kp COMMA  &kp DOT  &kp EQUAL
&kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_CONTROL  &mt LEFT_GUI LANGUAGE_2  &lt 2 SPACE  &kp TAB        &kp BACKSPACE  &lt 3 ENTER                             &kp LG(LS(N5))
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        default_layer_win {
            bindings = <
&kp Q           &kp W         &kp E             &kp R                    &kp T                                      &kp Y        &kp U  &st 5 I    &kp O    &kp P
&kp A           &kp S         &kp D             &kp F                    &kp G        &mkp MCLK      &kp SEMICOLON  &kp H        &kp J  &kp K      &kp L    &kp MINUS
&kp Z           &kp X         &kp C             &kp V                    &lt 4 B      &mo 8          &kp SLASH      &kp N        &kp M  &kp COMMA  &kp DOT  &kp EQUAL
&kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_CONTROL  &mt LEFT_GUI LANGUAGE_2  &lt 2 SPACE  &kp TAB        &kp BACKSPACE  &lt 3 ENTER                             &kp LG(LS(S))
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        cursor {
            bindings = <
&kp ESCAPE  &trans              &trans            &trans         &trans                            &trans  &trans     &mkp MCLK       &trans     &kp F12
&trans      &trans              &kp LC(UP_ARROW)  &trans         &trans  &trans            &trans  &trans  &mkp LCLK  &kp UP_ARROW    &mkp RCLK  &trans
&trans      &kp LC(LEFT_ARROW)  &kp LC(DOWN)      &kp LC(RIGHT)  &trans  &kp CAPSLOCK      &trans  &trans  &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &trans
&trans      &trans              &trans            &trans         &trans  &trans            &trans  &trans                                        &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        number {
            bindings = <
&kp SQT        &kp N7        &kp N8        &kp N9          &kp LEFT_PARENTHESIS                      &kp RIGHT_PARENTHESIS  &none               &none               &none                &trans
&kp GRAVE      &kp NUMBER_4  &kp N5        &kp NUMBER_6    &kp LEFT_BRACKET      &none       &trans  &kp RIGHT_BRACKET      &none               &kp LS(UP_ARROW)    &none                &trans
&kp BACKSLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp LEFT_BRACE        &none       &trans  &kp RIGHT_BRACE        &kp LS(LEFT_ARROW)  &kp LS(DOWN_ARROW)  &kp LS(RIGHT_ARROW)  &trans
&trans         &kp N0        &trans        &kp LANGUAGE_1  &trans                &trans      &trans  &trans                                                                              &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &trans
            >;
        };

        auto_mause_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        default_layer_winjis {
            bindings = <
&kp Q           &kp W         &kp E             &kp R                    &kp T                                      &kp Y        &kp U  &st 5 I    &kp O    &kp P
&kp A           &kp S         &kp D             &kp F                    &kp G        &mkp MCLK      &semi          &kp H        &kp J  &kp K      &kp L    &kp MINUS
&kp Z           &kp X         &kp C             &kp V                    &lt 4 B      &mo 8          &kp SLASH      &kp N        &kp M  &kp COMMA  &kp DOT  &kp EQUAL
&kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_CONTROL  &mt LEFT_GUI LANGUAGE_2  &lt 2 SPACE  &kp TAB        &kp BACKSPACE  &lt 7 ENTER                             &kp LG(LS(S))
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        numberjis {
            // JIS(日本語)キーボード設定のOS上で、US配列前提のHIDキーコードが
            // 物理位置ベースで別の記号に化けてしまう分だけ、狙った記号が出るキーコードに置換

            bindings = <
&kp LS(N7)            &kp N7        &kp N8        &kp N9          &kp LS(N8)                                 &kp LS(N9)         &none               &none               &none                &trans
&kp LS(LEFT_BRACKET)  &kp NUMBER_4  &kp N5        &kp NUMBER_6    &kp RIGHT_BRACKET      &none       &trans  &kp BACKSLASH      &none               &kp LS(UP_ARROW)    &none                &trans
&kp INT1              &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp LS(RIGHT_BRACKET)  &none       &trans  &kp LS(BACKSLASH)  &kp LS(LEFT_ARROW)  &kp LS(DOWN_ARROW)  &kp LS(RIGHT_ARROW)  &trans
&trans                &kp N0        &trans        &kp LANGUAGE_1  &trans                 &trans      &trans  &trans                                                                          &trans
            >;
        };

        // &mo 8 を押している間だけトラックボールを高速化するレイヤー(roBa_R.overlayのfast_moveオーバーライドで参照)

        trackball_speed {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
